{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["case_id", "question", "gold_context_keys"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "question": {"type": "string"},
    "gold_context_keys": {"type": "array", "items": {"type": "string"}},
    "required_evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "type": {"type": "string"}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["group_id", "keys"],
      "properties": {"group_id": {"type": "string"}, "keys": {"type": "array", "items": {"type": "string"}}}
    }
  }
}
