{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$ref": "#/$defs/success"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "table_diagnostic": {
      "type": "object",
      "required": [
        "bbox",
        "row_count",
        "column_count",
        "missing_cell_count",
        "observed_cell_geometry_count",
        "expected_cell_count",
        "signals",
        "decision",
        "rejection_reason"
      ],
      "properties": {
        "bbox": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "row_count": {
          "type": "integer",
          "minimum": 0
        },
        "column_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_cell_count": {
          "type": "integer",
          "minimum": 0
        },
        "observed_cell_geometry_count": {
          "type": "integer",
          "minimum": 0
        },
        "expected_cell_count": {
          "type": "integer",
          "minimum": 0
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decision": {
          "enum": [
            "confirmed_structured",
            "strong_unresolved",
            "weak_candidate"
          ]
        },
        "rejection_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "layout_review": {
      "type": "object",
      "properties": {
        "table_diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/table_diagnostic"
          }
        }
      },
      "additionalProperties": true
    },
    "form_diagnostics": {
      "type": "object",
      "required": [
        "drawing_count",
        "aligned_line_count",
        "long_horizontal_line_count",
        "text_line_count"
      ],
      "properties": {
        "drawing_count": {
          "type": "integer",
          "minimum": 0
        },
        "aligned_line_count": {
          "type": "integer",
          "minimum": 0
        },
        "long_horizontal_line_count": {
          "type": "integer",
          "minimum": 0
        },
        "text_line_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "required": [
        "page_number",
        "status",
        "attempts",
        "findings"
      ],
      "properties": {
        "page_number": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "VALIDATED",
            "USABLE_WITH_WARNINGS",
            "EXCLUDED_FORM",
            "NEEDS_REVIEW"
          ]
        },
        "attempts": {
          "type": "integer",
          "minimum": 1
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "page_classification": {
          "enum": [
            "text-native",
            "image-only",
            "mixed",
            "ambiguous",
            "form",
            null
          ]
        },
        "form_diagnostics": {
          "oneOf": [
            {
              "$ref": "#/$defs/form_diagnostics"
            },
            {
              "type": "object",
              "maxProperties": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "layout_review": {
          "oneOf": [
            {
              "$ref": "#/$defs/layout_review"
            },
            {
              "type": "null"
            }
          ]
        },
        "layout_confirmation": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "attempt_history": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "attempt",
              "status",
              "findings"
            ],
            "properties": {
              "attempt": {
                "type": "integer",
                "minimum": 1
              },
              "status": {
                "enum": [
                  "VALIDATED",
                  "USABLE_WITH_WARNINGS",
                  "EXCLUDED_FORM",
                  "NEEDS_REVIEW"
                ]
              },
              "findings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "layout_confirmation": {
                "type": [
                  "object",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "form_content_state": {
          "enum": [
            "blank",
            "filled",
            "unknown",
            null
          ]
        }
      },
      "additionalProperties": false
    },
    "success": {
      "type": "object",
      "required": [
        "schema_version",
        "operation",
        "request_id",
        "version_id",
        "status",
        "pages",
        "page_summary",
        "artifacts",
        "manifest"
      ],
      "properties": {
        "schema_version": {
          "const": "1"
        },
        "operation": {
          "enum": [
            "preprocess",
            "status"
          ]
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "version_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "QUEUED",
            "PROCESSING",
            "VALIDATING",
            "READY",
            "PARTIAL",
            "NEEDS_REVIEW"
          ]
        },
        "pages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/page"
          }
        },
        "page_summary": {
          "type": "object",
          "required": [
            "count",
            "processed",
            "validated",
            "usable_with_warnings",
            "excluded_forms",
            "needs_review",
            "ready"
          ],
          "additionalProperties": false,
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "processed": {
              "type": "integer",
              "minimum": 0
            },
            "validated": {
              "type": "integer",
              "minimum": 0
            },
            "usable_with_warnings": {
              "type": "integer",
              "minimum": 0
            },
            "excluded_forms": {
              "type": "integer",
              "minimum": 0
            },
            "needs_review": {
              "type": "integer",
              "minimum": 0
            },
            "ready": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "artifacts": {
          "type": "object",
          "required": [
            "manifest_sha256",
            "manifest",
            "version"
          ],
          "properties": {
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "manifest": {
              "$ref": "#/$defs/artifact"
            },
            "version": {
              "$ref": "#/$defs/artifact"
            },
            "chunks": {
              "$ref": "#/$defs/artifact"
            },
            "document_tree": {
              "$ref": "#/$defs/artifact"
            },
            "issues": {
              "$ref": "#/$defs/artifact"
            }
          },
          "additionalProperties": false
        },
        "manifest": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": [
        "schema_version",
        "operation",
        "request_id",
        "error"
      ],
      "properties": {
        "schema_version": {
          "const": "1"
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "request_id": {
          "type": "string"
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message",
            "exit_class"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "exit_class": {
              "enum": [
                "request",
                "processing",
                "interruption"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
