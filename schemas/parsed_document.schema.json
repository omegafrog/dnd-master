{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "preprocessing-agent/parsed-document",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_id", "source_path", "source_text", "pages", "metadata"],
  "properties": {
    "document_id": {"type": "string", "minLength": 1},
    "source_path": {"type": "string", "minLength": 1},
    "source_text": {"type": "string"},
    "pages": {"type": "array", "items": {"$ref": "#/$defs/page"}},
    "metadata": {"type": "object"}
  },
  "$defs": {
    "span": {
      "type": "object", "additionalProperties": false,
      "required": ["page_number", "block_index", "char_start", "char_end", "token_start", "token_end"],
      "properties": {
        "page_number": {"type": "integer", "minimum": 1}, "block_index": {"type": ["integer", "null"]},
        "char_start": {"type": ["integer", "null"]}, "char_end": {"type": ["integer", "null"]},
        "token_start": {"type": ["integer", "null"]}, "token_end": {"type": ["integer", "null"]}
      }
    },
    "block": {
      "type": "object", "additionalProperties": false,
      "required": ["block_id", "source_text", "source_span", "bbox", "font_size", "font_weight"],
      "properties": {
        "block_id": {"type": "string", "minLength": 1}, "source_text": {"type": "string", "minLength": 1},
        "source_span": {"$ref": "#/$defs/span"}, "bbox": {"type": ["array", "null"]},
        "font_size": {"type": ["number", "null"]}, "font_weight": {"type": ["string", "null"]}
      }
    },
    "page": {
      "type": "object", "additionalProperties": false,
      "required": ["page_number", "blocks", "source_text", "heading_associations", "tables"],
      "properties": {"page_number": {"type": "integer", "minimum": 1}, "blocks": {"type": "array", "items": {"$ref": "#/$defs/block"}}, "source_text": {"type": "string"}, "heading_associations": {"type": "array", "items": {"$ref": "#/$defs/heading_association"}}, "tables": {"type": "array", "items": {"$ref": "#/$defs/table"}}}
    },
    "heading_association": {
      "type": "object", "additionalProperties": false,
      "required": ["heading_block_id", "level", "associated_block_ids", "evidence", "confidence", "ambiguous", "findings"],
      "properties": {"heading_block_id": {"type": "string", "minLength": 1}, "level": {"type": "integer", "minimum": 1}, "associated_block_ids": {"type": "array", "items": {"type": "string"}}, "evidence": {"type": "array", "items": {"type": "string"}}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "ambiguous": {"type": "boolean"}, "findings": {"type": "array", "items": {"type": "string"}}}
    },
    "bbox": {"type": "object", "additionalProperties": false, "required": ["x0", "y0", "x1", "y1"], "properties": {"x0": {"type": "number", "minimum": 0}, "y0": {"type": "number", "minimum": 0}, "x1": {"type": "number", "minimum": 0}, "y1": {"type": "number", "minimum": 0}}},
    "cell": {
      "type": "object", "additionalProperties": false,
      "required": ["cell_id", "row_index", "column_index", "text", "bbox", "row_span", "column_span", "merged", "uncertain", "source_block_ids"],
      "properties": {"cell_id": {"type": "string"}, "row_index": {"type": "integer"}, "column_index": {"type": "integer"}, "text": {"type": "string"}, "bbox": {"$ref": "#/$defs/bbox"}, "row_span": {"type": "integer"}, "column_span": {"type": "integer"}, "merged": {"type": "boolean"}, "uncertain": {"type": "boolean"}, "source_block_ids": {"type": "array", "items": {"type": "string"}}}
    },
    "row": {"type": "object", "additionalProperties": false, "required": ["row_index", "cells", "header"], "properties": {"row_index": {"type": "integer"}, "cells": {"type": "array", "items": {"$ref": "#/$defs/cell"}}, "header": {"type": "boolean"}}},
    "table": {
      "type": "object", "additionalProperties": false,
      "required": ["table_id", "bbox", "header_rows", "rows", "cells", "merged_cell_ids", "uncertain_cell_ids", "findings", "confidence"],
      "properties": {"table_id": {"type": "string", "minLength": 1}, "bbox": {"$ref": "#/$defs/bbox"}, "header_rows": {"type": "array", "items": {"$ref": "#/$defs/row"}}, "rows": {"type": "array", "items": {"$ref": "#/$defs/row"}}, "cells": {"type": "array", "items": {"$ref": "#/$defs/cell"}}, "merged_cell_ids": {"type": "array", "items": {"type": "string"}}, "uncertain_cell_ids": {"type": "array", "items": {"type": "string"}}, "findings": {"type": "array", "items": {"type": "string"}}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}
    }
  }
}
