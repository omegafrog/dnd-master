{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "preprocessing-agent/heading-table",
  "type": "object",
  "additionalProperties": false,
  "required": ["table_id", "bbox", "header_rows", "rows", "cells", "merged_cell_ids", "uncertain_cell_ids", "findings", "confidence"],
  "properties": {
    "table_id": {"type": "string", "minLength": 1},
    "bbox": {"$ref": "#/$defs/bbox"},
    "header_rows": {"type": "array", "items": {"$ref": "#/$defs/row"}},
    "rows": {"type": "array", "items": {"$ref": "#/$defs/row"}},
    "cells": {"type": "array", "items": {"$ref": "#/$defs/cell"}},
    "merged_cell_ids": {"type": "array", "items": {"type": "string"}},
    "uncertain_cell_ids": {"type": "array", "items": {"type": "string"}},
    "findings": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "$defs": {
    "bbox": {"type": "object", "additionalProperties": false, "required": ["x0", "y0", "x1", "y1"], "properties": {"x0": {"type": "number"}, "y0": {"type": "number"}, "x1": {"type": "number"}, "y1": {"type": "number"}}},
    "cell": {"type": "object", "additionalProperties": false, "required": ["cell_id", "row_index", "column_index", "text", "bbox", "row_span", "column_span", "merged", "uncertain", "source_block_ids"], "properties": {"cell_id": {"type": "string"}, "row_index": {"type": "integer"}, "column_index": {"type": "integer"}, "text": {"type": "string"}, "bbox": {"$ref": "#/$defs/bbox"}, "row_span": {"type": "integer"}, "column_span": {"type": "integer"}, "merged": {"type": "boolean"}, "uncertain": {"type": "boolean"}, "source_block_ids": {"type": "array", "items": {"type": "string"}}}},
    "row": {"type": "object", "additionalProperties": false, "required": ["row_index", "cells", "header"], "properties": {"row_index": {"type": "integer"}, "cells": {"type": "array", "items": {"$ref": "#/$defs/cell"}}, "header": {"type": "boolean"}}}
  }
}
