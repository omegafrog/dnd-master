{"source_sha256":"7f3917fffb205a0e09f80145bc8bd78c982ad9a6fef18d9d84b64b9d4b5ece8e","page_number":2,"page_type":"text-native","blocks":[{"id":"a-cairn-warden-2-b1","text":"Cairn 2e Warden’s Guide","bbox":[70.67,42.84,307.33,70.54]},{"id":"a-cairn-warden-2-b2","text":"The Warden’s Guide includes tools, tables, and advice for running Cairn, with","bbox":[36.74,76.65,343.5,88.42]},{"id":"a-cairn-warden-2-b3","text":"procedures to generate content that fits into the Vald setting or any fantasy world of your imagining. The following chapters offer resources and detailed instructions for creating immersive adventures, with an emphasis on dynamic gameplay and rich worldbuilding. It is our hope that with these pages anyone can","bbox":[28.72,88.65,351.52,136.42]},{"id":"a-cairn-warden-2-b4","text":"craft unique, challenging experiences that engage and captivate players.","bbox":[46.67,136.65,331.34,148.42]},{"id":"a-cairn-warden-2-b5","text":"Credits & Acknowledgements","bbox":[62.56,163.57,315.44,188.5]},{"id":"a-cairn-warden-2-b6","text":"Writing Yochai Gal","bbox":[167.92,199.98,210.08,224.42]},{"id":"a-cairn-warden-2-b7","text":"Editing & Development","bbox":[133.83,231.98,244.18,245.83]},{"id":"a-cairn-warden-2-b8","text":"Derek B.","bbox":[172.3,244.65,205.7,256.42]},{"id":"a-cairn-warden-2-b9","text":"Copy Editing","bbox":[158.26,263.98,219.75,277.83]},{"id":"a-cairn-warden-2-b10","text":"Yossi Krausz","bbox":[163.96,276.65,214.04,288.42]},{"id":"a-cairn-warden-2-b11","text":"Layout, Design, & Example Maps","bbox":[111.76,295.98,266.25,309.83]},{"id":"a-cairn-warden-2-b12","text":"Adam Hensley","bbox":[160.82,308.65,217.18,320.42]},{"id":"a-cairn-warden-2-b13","text":"Cover Art Bruno Prosaiko","bbox":[158.77,327.98,219.23,352.42]},{"id":"a-cairn-warden-2-b14","text":"Interior Illustrations","bbox":[138.76,359.98,239.24,373.83]},{"id":"a-cairn-warden-2-b15","text":"Amanda Lee Franck","bbox":[150.25,372.65,227.75,384.42]},{"id":"a-cairn-warden-2-b16","text":"Bestiary Art Roque Romero","bbox":[159.85,391.98,218.15,416.42]},{"id":"a-cairn-warden-2-b17","text":"Character Sheet","bbox":[150.22,423.98,227.79,437.83]},{"id":"a-cairn-warden-2-b18","text":"Licopeo","bbox":[173.28,436.65,204.73,448.42]},{"id":"a-cairn-warden-2-b19","text":"Cairn 2 nd Edition • Version 1.0.0. • March 2026 • Text is CC BY-SA 4.0","bbox":[62.03,558.09,316.34,569.17]},{"id":"a-cairn-warden-2-b20","text":"cairnrpg.com","bbox":[162.55,542.91,216.17,554.69]},{"id":"a-cairn-warden-2-b21","text":"Page 2","bbox":[27.0,587.64,48.12,597.34]}],"reading_order":["a-cairn-warden-2-b1","a-cairn-warden-2-b2","a-cairn-warden-2-b3","a-cairn-warden-2-b4","a-cairn-warden-2-b5","a-cairn-warden-2-b6","a-cairn-warden-2-b7","a-cairn-warden-2-b8","a-cairn-warden-2-b9","a-cairn-warden-2-b10","a-cairn-warden-2-b11","a-cairn-warden-2-b12","a-cairn-warden-2-b13","a-cairn-warden-2-b14","a-cairn-warden-2-b15","a-cairn-warden-2-b16","a-cairn-warden-2-b17","a-cairn-warden-2-b18","a-cairn-warden-2-b20","a-cairn-warden-2-b19","a-cairn-warden-2-b21"],"headings":[{"id":"h-cairn-warden-2-1","block_id":"a-cairn-warden-2-b1","level":1},{"id":"h-cairn-warden-2-2","block_id":"a-cairn-warden-2-b5","level":2}]}
{"source_sha256":"7f3917fffb205a0e09f80145bc8bd78c982ad9a6fef18d9d84b64b9d4b5ece8e","page_number":3,"page_type":"mixed","blocks":[{"id":"a-cairn-warden-3-b1","text":"Table of Contents","bbox":[122.67,42.84,291.33,70.54]},{"id":"a-cairn-warden-3-b2","text":"Part 1: World Building ��������������������������������������������������������������������������������������������4","bbox":[45.0,77.51,355.0,89.97]},{"id":"a-cairn-warden-3-b3","text":"Setting Seeds �������������������������������������������������������������������������������������������������������������������6","bbox":[45.0,93.06,355.0,104.84]},{"id":"a-cairn-warden-3-b4","text":"Factions �����������������������������������������������������������������������������������������������������������������������������8","bbox":[45.0,108.06,355.0,119.84]},{"id":"a-cairn-warden-3-b5","text":"Topography �������������������������������������������������������������������������������������������������������������������14","bbox":[45.0,123.06,355.0,134.84]},{"id":"a-cairn-warden-3-b6","text":"Dungeon Seeds �������������������������������������������������������������������������������������������������������������32","bbox":[45.0,138.06,355.0,149.84]},{"id":"a-cairn-warden-3-b7","text":"Forest Seeds ������������������������������������������������������������������������������������������������������������������56","bbox":[45.0,153.06,355.0,164.84]},{"id":"a-cairn-warden-3-b8","text":"Part 2: Warden Tools ��������������������������������������������������������������������������������������������80","bbox":[45.0,176.51,355.0,188.97]},{"id":"a-cairn-warden-3-b9","text":"Bestiary ���������������������������������������������������������������������������������������������������������������������������82","bbox":[45.0,192.06,355.0,203.84]},{"id":"a-cairn-warden-3-b10","text":"Creating Monsters �����������������������������������������������������������������������������������������������������106","bbox":[45.0,207.06,355.0