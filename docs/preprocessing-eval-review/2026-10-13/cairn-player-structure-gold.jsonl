{"source_sha256":"ed2869946b0de9d97398c975a3dde8d5701250eb4c8776cb40907fe23c6300bb","page_number":2,"page_type":"text-native","blocks":[{"id":"a-cairn-player-2-b1","text":"Cairn 2e Player’s Guide","bbox":[87.13,33.84,308.87,61.54]},{"id":"a-cairn-player-2-b2","text":"Cairn is an adventure game about exploring a dark and mysterious Wood filled","bbox":[43.21,62.15,355.03,73.92]},{"id":"a-cairn-player-2-b3","text":"with strange folk, hidden treasure, and unspeakable monstrosities. Character","bbox":[45.79,73.15,352.45,84.92]},{"id":"a-cairn-player-2-b4","text":"generation is quick and random, adventures are tense and reward careful","bbox":[53.28,84.15,344.96,95.92]},{"id":"a-cairn-player-2-b5","text":"exploration, and combat is frantic and deadly.","bbox":[107.72,95.15,288.28,106.92]},{"id":"a-cairn-player-2-b6","text":"Credits & Acknowledgements","bbox":[71.56,117.17,324.44,142.1]},{"id":"a-cairn-player-2-b7","text":"Writing","bbox":[175.46,147.25,220.54,163.87]},{"id":"a-cairn-player-2-b8","text":"Yochai Gal","bbox":[176.92,164.49,219.08,176.26]},{"id":"a-cairn-player-2-b9","text":"Editing & Development","bbox":[131.79,183.99,264.21,200.61]},{"id":"a-cairn-player-2-b10","text":"Derek B.","bbox":[181.3,201.23,214.7,213.0]},{"id":"a-cairn-player-2-b11","text":"Copy Editing","bbox":[161.11,220.73,234.89,237.35]},{"id":"a-cairn-player-2-b12","text":"Yossi Krausz","bbox":[172.96,237.97,223.04,249.74]},{"id":"a-cairn-player-2-b13","text":"Layout & Design","bbox":[151.36,257.47,244.64,274.09]},{"id":"a-cairn-player-2-b14","text":"Adam Hensley","bbox":[169.82,274.71,226.18,286.48]},{"id":"a-cairn-player-2-b15","text":"Cover Art","bbox":[170.2,294.21,225.8,310.83]},{"id":"a-cairn-player-2-b16","text":"Bruno Prosaiko","bbox":[167.77,311.45,228.23,323.22]},{"id":"a-cairn-player-2-b17","text":"Backgrounds Art","bbox":[149.65,330.95,246.35,347.57]},{"id":"a-cairn-player-2-b18","text":"Keny Widjaja","bbox":[172.28,348.19,223.72,359.96]},{"id":"a-cairn-player-2-b19","text":"Interior Illustrations","bbox":[137.71,367.69,258.29,384.31]},{"id":"a-cairn-player-2-b20","text":"Amanda Lee Franck","bbox":[159.25,384.93,236.75,396.7]},{"id":"a-cairn-player-2-b21","text":"Wilderness Exploration Sketch","bbox":[109.09,404.43,286.91,421.05]},{"id":"a-cairn-player-2-b22","text":"Adam Hensley","bbox":[169.82,421.67,226.18,433.44]},{"id":"a-cairn-player-2-b23","text":"The author would like to thank all 4,649 backers who helped make this project a","bbox":[45.8,499.19,352.44,510.48]},{"id":"a-cairn-player-2-b24","text":"reality, as well as his wife, Sarah. (She knows why.) And a special thanks to our","bbox":[47.49,510.19,350.75,521.48]},{"id":"a-cairn-player-2-b25","text":"Discord community for help with playtest feedback.","bbox":[99.73,521.19,296.27,532.48]},{"id":"a-cairn-player-2-b26","text":"cairnrpg.com","bbox":[171.19,536.1,224.81,547.87]},{"id":"a-cairn-player-2-b27","text":"Cairn 2 nd Edition • Version 1.0.0. • April 2026 • Text is CC BY-SA 4.0","bbox":[74.0,565.06,322.0,576.14]}],"reading_order":["a-cairn-player-2-b1","a-cairn-player-2-b2","a-cairn-player-2-b3","a-cairn-player-2-b4","a-cairn-player-2-b5","a-cairn-player-2-b6","a-cairn-player-2-b7","a-cairn-player-2-b8","a-cairn-player-2-b9","a-cairn-player-2-b10","a-cairn-player-2-b11","a-cairn-player-2-b12","a-cairn-player-2-b13","a-cairn-player-2-b14","a-cairn-player-2-b15","a-cairn-player-2-b16","a-cairn-player-2-b17","a-cairn-player-2-b18","a-cairn-player-2-b19","a-cairn-player-2-b20","a-cairn-player-2-b21","a-cairn-player-2-b22","a-cairn-player-2-b23","a-cairn-player-2-b24","a-cairn-player-2-b25","a-cairn-player-2-b26","a-cairn-player-2-b27"],"headings":[{"id":"h-cairn-player-2-1","block_id":"a-cairn-player-2-b1","level":1},{"id":"h-cairn-player-2-2","block_id":"a-cairn-player-2-b6","level":2}]}
