{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dnd-master.local/contracts/rule-knowledge/v1/evidence-candidate-search-response.json",
  "title": "근거 후보 검색 결과",
  "description": "한 번의 검색 요청에서 최대 40개 후보를 반환한다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ownerId", "sessionId", "scenarioPackageId", "candidates"],
  "properties": {
    "ownerId": { "type": "string", "format": "uuid" },
    "sessionId": { "type": "string", "format": "uuid" },
    "scenarioPackageId": { "type": "string", "format": "uuid" },
    "candidates": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chunkId", "documentId", "extractionVersion", "documentType", "locator", "excerpt", "provenance", "denseRank", "denseSimilarity"],
        "properties": {
          "chunkId": { "type": "string", "format": "uuid" },
          "documentId": { "type": "string", "format": "uuid" },
          "extractionVersion": { "type": "integer", "minimum": 1 },
          "documentType": { "enum": ["RULEBOOK", "STORYBOOK"] },
          "locator": { "type": "string", "minLength": 1 },
          "excerpt": { "type": "string", "minLength": 1 },
          "provenance": { "$ref": "published-evidence-provenance.json" },
          "denseRank": { "type": ["integer", "null"], "minimum": 1 },
          "denseSimilarity": { "type": ["number", "null"], "minimum": -1, "maximum": 1 }
        }
      }
    }
  }
}
