{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dnd-master.local/contracts/rule-knowledge/v1/evidence-candidate-search-request.json",
  "title": "한 번의 문서 근거 검색 요청",
  "type": "object",
  "additionalProperties": false,
  "required": ["ownerId", "sessionId", "scenarioPackageId", "stageKey", "actionIntent", "scope", "activeLocators", "excludedEvidenceIds", "query", "denseLimit"],
  "properties": {
    "ownerId": { "type": "string", "format": "uuid" },
    "sessionId": { "type": "string", "format": "uuid" },
    "scenarioPackageId": { "type": "string", "format": "uuid" },
    "stageKey": { "type": "string", "minLength": 1 },
    "actionIntent": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["documentId", "extractionVersion", "documentType"],
        "properties": {
          "documentId": { "type": "string", "format": "uuid" },
          "extractionVersion": { "type": "integer", "minimum": 1 },
          "documentType": { "enum": ["RULEBOOK", "STORYBOOK"] }
        }
      }
    },
    "activeLocators": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "excludedEvidenceIds": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "pattern": "^IMMUTABLE_DOCUMENT:(RULEBOOK|STORYBOOK):[^:]+:[1-9][0-9]*:.+$" }
    },
    "query": { "type": "string", "minLength": 1 },
    "denseLimit": { "type": "integer", "minimum": 1, "maximum": 30 },
    "minimumDenseSimilarity": { "type": "number", "minimum": -1, "maximum": 1 }
  }
}
