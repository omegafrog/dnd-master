{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dnd-master.local/contracts/ai-game-master/v1/runtime-turn-request.json",
  "title": "턴 진행 요청",
  "type": "object",
  "additionalProperties": false,
  "required": ["soloPlayerId", "operationKey", "action", "endpointId", "provider", "model", "reasoning", "effectiveEndpointId", "effectiveEndpointVersion", "effectiveProvider", "effectiveModel", "prompt"],
  "properties": {
    "soloPlayerId": { "type": "string", "format": "uuid" },
    "operationKey": { "type": "string", "minLength": 1 },
    "action": { "type": "string", "minLength": 1 },
    "endpointId": { "type": "string", "format": "uuid" },
    "provider": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "reasoning": { "type": "string", "minLength": 1 },
    "effectiveEndpointId": { "type": "string", "format": "uuid" },
    "effectiveEndpointVersion": { "type": "string", "minLength": 1 },
    "effectiveProvider": { "type": "string", "minLength": 1 },
    "effectiveModel": { "type": "string", "minLength": 1 },
    "prompt": { "type": "string", "minLength": 1 },
    "ragSearchContext": { "type": ["object", "null"] }
  }
}
