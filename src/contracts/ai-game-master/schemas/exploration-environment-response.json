{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["narration", "enemyMoves", "featureInteractions", "encounterRequested", "hostileActionStarted", "threatDiscovery"],
  "properties": {
    "narration": { "type": "string", "minLength": 1 },
    "encounterRequested": { "type": "boolean" },
    "hostileActionStarted": { "type": "boolean" },
    "threatDiscovery": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["discovererCharacterSheetIds", "enemyDiscoveredFirst", "enemyHeardNotification", "bothSidesNotHidden", "awareEnemyTokenIds"],
          "properties": {
            "discovererCharacterSheetIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "format": "uuid" } },
            "enemyDiscoveredFirst": { "type": "boolean" },
            "enemyHeardNotification": { "type": "boolean" },
            "bothSidesNotHidden": { "type": "boolean" },
            "awareEnemyTokenIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "format": "uuid" } }
          }
        }
      ]
    },
    "featureInteractions": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["featureId"],
        "properties": { "featureId": { "type": "string", "format": "uuid" } }
      }
    },
    "enemyMoves": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tokenId", "path"],
        "properties": {
          "tokenId": { "type": "string", "format": "uuid" },
          "path": {
            "type": "array", "minItems": 2, "maxItems": 100,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["x", "y"],
              "properties": { "x": { "type": "integer", "minimum": 0 }, "y": { "type": "integer", "minimum": 0 } }
            }
          }
        }
      }
    }
  }
}
