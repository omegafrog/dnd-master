{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dnd-master.local/contracts/ai-game-master/v1/runtime-turn-response.json",
  "title": "턴 진행 응답",
  "type": "object",
  "additionalProperties": false,
  "required": ["scene", "judgment", "narration", "combatStart", "combatEnemies", "situation", "mapEntryRequested", "판정제안"],
  "properties": {
    "scene": { "type": "string", "minLength": 1 },
    "judgment": { "type": "string", "minLength": 1 },
    "narration": { "type": "string", "minLength": 1 },
    "combatStart": { "type": "boolean" },
    "combatEnemies": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["enemyKey", "name", "count"],
        "properties": {
          "mode": { "enum": ["SCENARIO", "SITUATION", "INSTANT"] },
          "scenarioId": { "type": "string" }, "enemyKey": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 }, "count": { "type": "integer", "minimum": 1 },
          "abilities": { "type": "array", "items": { "type": "object", "additionalProperties": false,
            "required": ["ability", "score", "citationKeys"], "properties": {
              "ability": { "type": "string", "minLength": 1 }, "score": { "type": "integer", "minimum": 1, "maximum": 30 },
              "citationKeys": { "type": "array", "items": { "type": "string" } } } } },
          "actions": { "type": "array", "items": { "type": "object", "additionalProperties": false,
            "required": ["name", "description", "citationKeys"], "properties": {
              "name": { "type": "string", "minLength": 1 }, "description": { "type": "string", "minLength": 1 },
              "citationKeys": { "type": "array", "items": { "type": "string" } } } } }
        }
      }
    },
    "situation": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "location", "problem", "threat", "goal", "basis", "required"],
      "properties": {
        "kind": { "enum": ["CONTINUE", "TRANSITION"] }, "location": { "type": "string", "minLength": 1 },
        "problem": { "type": "string", "minLength": 1 }, "threat": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 }, "basis": { "enum": ["SCENARIO", "RAG", "FALLBACK"] },
        "reference": { "type": "string" }, "required": { "type": "boolean" }
      }
    },
    "mapEntryRequested": { "type": "boolean" },
    "runtimeFacts": { "type": "array", "items": { "type": "object", "additionalProperties": false,
      "required": ["subject", "content"], "properties": {
        "subject": { "type": "string", "minLength": 1 }, "content": { "type": "string", "minLength": 1 } } } },
    "completion": { "type": "object", "additionalProperties": false,
      "required": ["complete"], "properties": {
        "complete": { "type": "boolean" }, "resolvedObjectiveIds": { "type": "array", "items": { "type": "string" } },
        "satisfiedResolutionCriteriaIds": { "type": "array", "items": { "type": "string" } }, "concludingScene": { "type": "string" } } },
    "citedEvidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "판정제안": { "type": "object", "additionalProperties": false, "required": ["필요"],
      "properties": {
        "필요": { "type": "boolean" }, "이유": { "type": "string" }, "판정능력또는기술": { "type": "string" },
        "대상캐릭터ID": { "type": "string", "format": "uuid" }, "굴림주체": { "enum": ["플레이어", "시스템"] },
        "굴림식": { "type": "string" }, "보정치": { "type": "integer", "minimum": -10, "maximum": 20 },
        "난이도": { "type": "integer", "minimum": 1, "maximum": 40 }, "근거키": { "type": "array", "items": { "type": "string" } },
        "성공시결과": { "type": "string" }, "실패시결과": { "type": "string" }
      },
      "allOf": [{ "if": { "properties": { "필요": { "const": true } } },
        "then": { "required": ["이유", "판정능력또는기술", "대상캐릭터ID", "굴림주체", "굴림식", "보정치", "난이도", "근거키", "성공시결과", "실패시결과"] } }]
    }
  },
  "allOf": [{ "if": { "properties": { "combatStart": { "const": true } } },
    "then": { "properties": { "combatEnemies": { "minItems": 1 } } } }]
}
