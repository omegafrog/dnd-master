{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["baseSchema", "storybookProposals", "storybookExtractionState"],
  "properties": {
    "baseSchema": { "type": "object", "required": ["edition", "fields"], "properties": { "edition": { "type": "string", "minLength": 1 }, "fields": { "type": "array", "items": { "type": "object", "required": ["key", "options", "required", "sourceType", "inputStatus", "diagnostics", "inputMode", "suggestions", "sourceQuote", "evidence", "optionDetails"], "properties": { "key": { "type": "string", "minLength": 1 }, "options": { "type": "array", "items": { "type": "string" } }, "required": { "type": "boolean" }, "sourceType": { "enum": ["RULEBOOK", "TEMPLATE"] }, "inputStatus": { "type": "string" }, "diagnostics": { "type": "array", "items": { "type": "string" } }, "inputMode": { "type": "string" }, "suggestions": { "type": "array", "items": { "type": "string" } }, "sourceQuote": { "type": "string" }, "evidence": { "type": "array", "items": { "$ref": "#/$defs/sourceReference" } }, "optionDetails": { "type": "array" } } } } } },
    "storybookProposals": { "type": "array", "items": { "type": "object", "required": ["proposalId", "key", "label", "description", "sourceDocument", "sourceQuote", "evidence", "decisionState", "readinessState"], "properties": { "proposalId": { "type": "string", "minLength": 1 }, "key": { "type": "string", "minLength": 1 }, "label": { "type": "string" }, "description": { "type": "string" }, "sourceDocument": { "anyOf": [{ "$ref": "#/$defs/sourceDocument" }, { "type": "null" }] }, "sourceQuote": { "type": "string" }, "evidence": { "type": "array", "items": { "$ref": "#/$defs/sourceEvidence" } }, "decisionState": { "description": "036-1 safely emits UNDECIDED until later decision commands and persistence exist.", "enum": ["UNDECIDED", "APPLIED", "EXCLUDED", "NEEDS_EVIDENCE"] }, "readinessState": { "enum": ["READY", "INSUFFICIENT_EVIDENCE"] } } } },
    "storybookExtractionState": { "enum": ["NO_PROPOSALS", "PROPOSALS_AVAILABLE", "EXTRACTION_FAILED", "INSUFFICIENT_EVIDENCE", "EXTRACTION_PARTIAL_AWAITING_CONFIRMATION", "EXTRACTION_PARTIAL_CONFIRMED", "EXTRACTION_MIXED"] }
  },
  "$defs": {
    "sourceDocument": { "type": "object", "required": ["knowledgeDocumentId", "originalFilename", "extractionVersion"], "properties": { "knowledgeDocumentId": { "type": "string", "minLength": 1 }, "originalFilename": { "type": "string", "minLength": 1 }, "extractionVersion": { "type": "integer", "minimum": 1 } } },
    "sourceReference": { "type": "object", "required": ["knowledgeDocumentId", "extractionVersion", "locator"], "properties": { "knowledgeDocumentId": { "type": "string", "minLength": 1 }, "extractionVersion": { "type": "integer", "minimum": 1 }, "locator": { "type": "string", "minLength": 1 } } },
    "sourceEvidence": { "type": "object", "required": ["locator", "excerpt"], "properties": { "locator": { "type": "string", "minLength": 1 }, "excerpt": { "type": "string" } } }
  }
}
