    "test:e2e:character": "playwright test e2e/backend-character-creation.spec.ts",
    "test:e2e:character:fresh": "playwright test e2e/backend-character-bootstrap.spec.ts"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-kr": "^5.3.0",
    "class-variance-authority": "^0.7.1",
